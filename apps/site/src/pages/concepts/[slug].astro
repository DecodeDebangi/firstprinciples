---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ConceptH2 from "../../components/ConceptH2.astro";
import Base from "../../layouts/Base.astro";
import { allTopics, practisedTopics, topicSlug } from "../../data/roadmap";

export async function getStaticPaths() {
  const concepts = await getCollection("concepts");
  const problems = await getCollection("dsa");
  return concepts.map((c) => ({ params: { slug: c.id }, props: { c, concepts, problems } }));
}

interface Props {
  c: CollectionEntry<"concepts">;
  concepts: CollectionEntry<"concepts">[];
  problems: CollectionEntry<"dsa">[];
}
const { c, concepts, problems } = Astro.props;
const { Content, headings } = await render(c);
const toc = headings.filter((h) => h.depth === 2);
const topic = allTopics.find((t) => t.name === c.data.topic)!;
const slug = topicSlug(topic.name);
const siblings = concepts.filter((x) => x.data.topic === c.data.topic).sort((a, b) => a.data.order - b.data.order);
const byOrder = (a: typeof c, b: typeof c) => a.data.order - b.data.order;
/** Next read: the next one in this topic, or else the first read of the next roadmap topic that has one. */
const next = siblings[siblings.indexOf(c) + 1]
  ?? allTopics.slice(allTopics.indexOf(topic) + 1)
    .map((t) => concepts.filter((x) => x.data.topic === t.name).sort(byOrder)[0])
    .find(Boolean);
const rank = { Easy: 0, Medium: 1, Hard: 2 } as const;
/** For a topic with no problems of its own (Coding basics): a few gentle first problems. */
const GENTLE = ["two-sum", "contains-duplicate", "binary-search", "valid-parentheses"];
const practice = problems
  .filter((p) => practisedTopics(p.data.topics).includes(topic))
  .sort((a, b) => rank[a.data.difficulty] - rank[b.data.difficulty] || a.data.leetcode.number - b.data.leetcode.number);
const gentle = practice.length ? [] : GENTLE.map((id) => problems.find((p) => p.id === id)).filter((p) => p !== undefined);
---
<Base title={c.data.title} description={c.data.summary} type="article">
  <article class="prose">
    <a class="back" href={`/topics/${slug}/`}>← {topic.name}</a>
    <p class="eyebrow"><span class="kind">{c.data.kind}</span> · {topic.name}</p>
    <h1>{c.data.title}</h1>
    <p class="lead">{c.data.summary}</p>
    <nav class="toc" aria-label="On this page">
      {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
    <Content components={{ h2: ConceptH2 }} />
    <aside class="after">
      {next ? (
        <a class="next" href={`/concepts/${next.id}/`}>Next read: {next.data.title} →</a>
      ) : null}
      <h2>Put it into practice</h2>
      {practice.length ? (
        <ul>
          {practice.slice(0, 6).map((p) => (
            <li><a href={`/dsa/${p.id}/`}><span class="num">#{p.data.leetcode.number}</span> {p.data.title}</a> <span class={`pill pill--${p.data.difficulty}`}>{p.data.difficulty}</span></li>
          ))}
        </ul>
      ) : gentle.length ? (
        <>
          <p>Ready for a first problem? These are the gentlest, and each one starts from the most obvious idea:</p>
          <ul>
            {gentle.map((p) => (
              <li><a href={`/dsa/${p.id}/`}><span class="num">#{p.data.leetcode.number}</span> {p.data.title}</a> <span class={`pill pill--${p.data.difficulty}`}>{p.data.difficulty}</span></li>
            ))}
          </ul>
        </>
      ) : (
        <p>Problems for {topic.name} are on the way. Meanwhile, <a href="/problems/">browse all problems</a>.</p>
      )}
      {practice.length > 6 && <a href={`/topics/${slug}/`}>All {practice.length} {topic.name} problems →</a>}
    </aside>
  </article>
</Base>

<style>
  .back { font-size: 15px; text-decoration: none; display: inline-block; margin-bottom: 12px; }
  .eyebrow { margin: 0 0 6px; font-size: 13px; color: var(--muted); }
  .kind { font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: .05em; font-size: 12px; }
  .lead { font-size: 19px; color: var(--text-2); max-width: 64ch; margin: 0; }
  .toc { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 20px 0 0; padding: 12px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); font-size: 14px; }
  .toc a { text-decoration: none; }
  .after { margin-top: 56px; padding: 24px; border-radius: 20px; background: var(--accent-soft); }
  .after h2 { margin: 0 0 10px; }
  .after ul { margin: 0 0 10px; padding: 0; list-style: none; display: grid; gap: 6px; }
  .after li { display: flex; align-items: center; gap: 10px; }
  .after li a { font-weight: 600; text-decoration: none; color: var(--text); }
  .after li a:hover { color: var(--accent); }
  .num { font: 500 13px var(--font-mono); color: var(--muted); }
  .next { display: inline-block; margin-bottom: 18px; font-weight: 700; text-decoration: none; }
</style>
