---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { practisedTopics, homeTopic, topicSlug } from "../../data/roadmap";
import ProblemH2 from "../../components/ProblemH2.astro";
import ProgressToggle from "../../components/ProgressToggle.tsx";

export async function getStaticPaths() {
  const problems = await getCollection("dsa");
  return problems.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content, headings } = await render(p);
const toc = headings.filter((h) => h.depth === 2);
const topicNames = practisedTopics(p.data.topics).map((t) => t.name);
const background = (await getCollection("concepts")).filter((c) => topicNames.includes(c.data.topic)).sort((a, b) => a.data.order - b.data.order);
const home = homeTopic(p.data.topics);
// For the "try it first" box, which ProblemH2 places before the first solution section.
Astro.locals.tryFirst = {
  slug: p.id,
  leetcodeUrl: p.data.leetcode.url,
  number: p.data.leetcode.number,
  pattern: home && { name: home.name, href: `/topics/${topicSlug(home.name)}/` },
  best: p.data.best,
  route: toc.filter((h) => /^Approach \d+:/.test(h.text)).map((h) => h.text.replace(/^Approach \d+:\s*/, "")),
};
/** "Find the two positions … target. Goes from …" → its first sentence: what the problem asks. */
const firstSentence = (s: string) => s.split(/(?<=[.?!])\s/)[0];
const added = p.data.added.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Base title={p.data.title} description={p.data.summary} type="article"
  image={`/og/${p.id}.png`}
  imageAlt={`${p.data.title}: from brute force to ${p.data.best.time}, with step-by-step animations`}>
  <article class="prose">
    <script is:inline define:vars={{ slug: p.id }}>
      // Try it first: hide the solutions before they paint, unless the reader solved it or followed a deep link.
      try {
        if (localStorage.getItem("firstprinciples:tryfirst") === "1") {
          const d = document.documentElement, q = new URLSearchParams(location.search), h = location.hash.slice(1);
          d.classList.add("tf-on");
          const solved = JSON.parse(localStorage.getItem("firstprinciples:progress") || "{}")?.problems?.[slug]?.status === "solved";
          if (solved || q.has("step") || q.has("approach") || (h && h !== "the-problem" && h !== "the-key-question")) d.classList.add("tf-open");
        }
      } catch {}
    </script>
    <a class="back" href="/problems/">← All problems</a>
    <h1 data-pslug={p.id}>{p.data.title}</h1>
    <div class="meta">
      <span class={`pill pill--${p.data.difficulty}`}>{p.data.difficulty}</span>
      {p.data.topics.map((t) => <span class="pill">{t}</span>)}
      <span class="added">Added {added}</span>
    </div>
    <div class="actions">
      <a class="act act--primary" href={p.data.leetcode.url} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m8 7-5 5 5 5M16 7l5 5-5 5" />
        </svg>
        Solve on LeetCode #{p.data.leetcode.number} <span aria-hidden="true">↗</span>
      </a>
      {p.data.reel && (
        <a class="act" href={p.data.reel} target="_blank" rel="noopener" aria-label={`Watch the ${p.data.title} reel on Instagram`}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
          </svg>
          Watch the reel
        </a>
      )}
    </div>
    <section class="om" aria-labelledby="om-title">
      <h2 class="om__title" id="om-title">In one minute</h2>
      <dl>
        <div><dt>The problem</dt><dd>{firstSentence(p.data.summary)}</dd></div>
        {p.data.insight && <div class="om__spoil"><dt>The trick</dt><dd>{p.data.insight}</dd></div>}
        <div class="om__spoil"><dt>Best</dt><dd><code>{p.data.best.time}</code> time · <code>{p.data.best.space}</code> space</dd></div>
        {background.length > 0 && (
          <div><dt>New to this?</dt><dd>Read first: {background.map((c, k) => <>{k > 0 && " · "}<a href={`/concepts/${c.id}/`}>{c.data.title}</a></>)}</dd></div>
        )}
      </dl>
    </section>
    <nav class="toc" aria-label="On this page">
      {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
    <Content components={{ h2: ProblemH2 }} />
    <aside class="your-turn" aria-label="Practice">
      <h2>Your turn</h2>
      <p>You've seen every approach run. Now write the optimal one yourself, without looking, and check it against LeetCode's tests.</p>
      <a class="act act--primary" href={p.data.leetcode.url} target="_blank" rel="noopener">
        Solve {p.data.title} on LeetCode <span aria-hidden="true">↗</span>
      </a>
      <ProgressToggle client:visible slug={p.id} />
    </aside>
  </article>
</Base>

<style>
  .om { margin: 18px 0 0; padding: 14px 18px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--accent); }
  .om__title { margin: 0 0 8px; font: 700 13px var(--font-sans); text-transform: uppercase; letter-spacing: .06em; color: var(--accent); }
  .om dl { margin: 0; display: grid; gap: 8px; }
  .om dl > div { display: grid; grid-template-columns: 8.5em minmax(0, 1fr); gap: 12px; }
  .om dt { font-weight: 600; font-size: 14.5px; color: var(--muted); padding-top: 1px; }
  .om dd { margin: 0; font-size: 16px; }
  .om dd a { font-weight: 600; }
  @media (max-width: 560px) { .om dl > div { grid-template-columns: minmax(0, 1fr); gap: 0; } }
  .back { font-size: 15px; text-decoration: none; display: inline-block; margin-bottom: 12px; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 14px; }
  .added { color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .act {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 16px; border-radius: 999px;
    border: 1px solid var(--accent); color: var(--accent); background: var(--surface);
    font-size: 15px; font-weight: 600; text-decoration: none;
    transition: background-color .15s, color .15s, box-shadow .15s;
  }
  .act:hover { background: var(--accent-soft); color: var(--accent-hover); box-shadow: var(--shadow); }
  .act--primary { background: var(--accent); color: var(--on-accent); }
  .act--primary:hover { background: var(--accent-hover); color: var(--on-accent); }
  .your-turn {
    margin-top: 56px; padding: 28px; text-align: center;
    background: var(--accent-soft); border-radius: 20px;
  }
  .your-turn h2 { margin: 0 0 8px; }
  .your-turn p { margin: 0 auto 18px; max-width: 52ch; color: var(--text-2); }
  .toc { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 20px 0 0; padding: 12px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); font-size: 14px; }
  .toc a { text-decoration: none; }
</style>
