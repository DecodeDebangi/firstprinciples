---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Practice from "../components/Practice.tsx";
import { buildBank } from "../lib/bank";
import { allTopics, homeTopic } from "../data/roadmap";

const problems = await getCollection("dsa");
const concepts = await getCollection("concepts");
const bank = buildBank(problems, concepts);
// Topics in roadmap order, only those with questions.
const topics = allTopics.map((t) => t.name).filter((name) => bank.some((b) => b.topic === name));
const list = problems
  .map((p) => ({ slug: p.id, title: p.data.title, topic: homeTopic(p.data.topics)?.name ?? "" }))
  .sort((a, b) => a.title.localeCompare(b.title));
---
<Base title="Practice" description={`A few questions a day from ${bank.length}: theory, "which technique fits?" and complexity. Questions you miss come back sooner. No account; progress stays in your browser.`}>
  <section class="pr">
    <a class="back" href="/">← Home</a>
    <h1>Practice</h1>
    <p class="lead">
      Ten questions at a time, drawn from every read and every problem on the site: theory, "which technique fits this
      problem?" and "what's the best complexity?". Get one right and it waits longer before coming back (1, 3, 7, 16,
      then 35 days); miss it and it returns next time. A few minutes a day beats an evening once a month.
    </p>
    <Practice client:only="react" bank={bank} problems={list} topics={topics} />
    <noscript><p class="pr-card">Practice needs JavaScript. Every question is also at the end of its read or problem page.</p></noscript>
  </section>
</Base>

<style is:global>
  .pr .back { font-size: 15px; text-decoration: none; display: inline-block; margin-bottom: 12px; }
  .pr .lead { color: var(--text-2); max-width: 68ch; margin: 0 0 24px; }
  .pr-card { margin: 0 0 18px; padding: 20px 22px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .pr-card p { margin: 0 0 12px; }
  .pr-h { margin: 0 0 10px; font: 600 21px var(--font-serif); }
  .pr-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 18px; }
  .pr-stats div { display: flex; flex-direction: column; padding: 12px; border-radius: 12px; background: var(--surface-2); }
  .pr-stats strong { font: 700 26px var(--font-serif); color: var(--text); }
  .pr-stats span { font-size: 13.5px; color: var(--text-2); }
  .pr-topic { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 14px; font-size: 14px; color: var(--text-2); }
  .pr-topic select { font: 500 15px var(--font-sans); padding: 8px 10px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); color: var(--text); max-width: 100%; }
  .pr-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 4px; }
  .pr-row + .pr-row, .pr-paste + .pr-row { margin-top: 10px; }
  .pr-note { margin: 0 !important; color: var(--text-2); }
  .pr-btn { font: 600 15px var(--font-sans); padding: 9px 16px; border-radius: 999px; cursor: pointer; border: 1px solid var(--accent); background: var(--surface); color: var(--accent); }
  .pr-btn:hover:not(:disabled) { background: var(--accent-soft); }
  .pr-btn:disabled { opacity: .5; cursor: default; }
  .pr-btn:focus-visible, .pr-opt:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pr-btn--primary { background: var(--accent); color: var(--on-accent); }
  .pr-btn--primary:hover:not(:disabled) { background: var(--accent-hover); }
  .pr-btn--quiet { border-color: var(--border); color: var(--text-2); }
  .pr-file { position: relative; overflow: hidden; }
  .pr-file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .pr-file:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pr-paste { display: grid; gap: 6px; margin-top: 14px; font-size: 14px; color: var(--text-2); }
  .pr-paste textarea { font: 13px var(--font-mono); padding: 8px 10px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); color: var(--text); resize: vertical; width: 100%; box-sizing: border-box; }
  .pr-msg { margin: 12px 0 0 !important; font-size: 14px; }
  .pr-msg.is-ok { color: var(--tone-found-border); }
  .pr-msg.is-bad { color: var(--tone-miss-border); }
  .pr-list { margin: 0 0 14px; padding-left: 20px; display: grid; gap: 4px; }
  .pr-muted { color: var(--muted); font-size: 14px; }
  .pr-card__top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px; margin-bottom: 12px; font-size: 13px; }
  .pr-tag { font-weight: 600; color: var(--accent); }
  .pr-progress { color: var(--muted); font-family: var(--font-mono); }
  .pr-context { margin: 0 0 14px; padding: 10px 14px; border-left: 3px solid var(--accent); background: var(--accent-soft); border-radius: 0 10px 10px 0; color: var(--text); font-size: 15.5px; line-height: 1.55; }
  .pr-q { font-weight: 600; font-size: 17px; margin: 0 0 12px !important; }
  .pr-opts { display: grid; gap: 8px; }
  .pr-opt { text-align: left; font: 15.5px var(--font-sans); padding: 10px 14px; border-radius: 10px; cursor: pointer; border: 1px solid var(--border); background: var(--bg); color: var(--text); transition: border-color .15s, background-color .2s, opacity .2s; }
  .pr-opt:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .pr-opt:disabled { cursor: default; }
  .pr-opt.is-right { background: var(--tone-found-bg); border-color: var(--tone-found-border); color: var(--text); font-weight: 600; }
  .pr-opt.is-wrong { background: var(--tone-miss-bg); border-color: var(--tone-miss-border); color: var(--text); }
  .pr-opt.is-dim { opacity: .55; }
  .pr-why { margin-top: 14px; }
  .pr-why p { line-height: 1.55; }
  .pr-why.is-right strong { color: var(--tone-found-border); }
  .pr-why.is-wrong strong { color: var(--tone-miss-border); }
  .pr-why__more { font-size: 14px; color: var(--text-2); }
  @media (max-width: 560px) {
    .pr-card { padding: 16px; }
    .pr-stats { grid-template-columns: 1fr; gap: 8px; }
    .pr-stats div { flex-direction: row; align-items: baseline; gap: 8px; padding: 8px 12px; }
    .pr-stats strong { font-size: 20px; }
  }
</style>
