---
import "@firstprinciples/ui/tokens.css";
import "../styles/global.css";
import TermPopover from "../components/TermPopover.astro";
import Search from "../components/Search.astro";

interface Props {
  title: string;
  description: string;
  /** "article" for problem pages, "website" for everything else. */
  type?: "website" | "article";
  /** Keep a page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** Link preview image path; defaults to the site-wide card. */
  image?: string;
  imageAlt?: string;
}
const {
  title, description, type = "website", noindex = false,
  image = "/og.png",
  imageAlt = "firstprinciples: algorithms explained from brute force to optimal, with step-by-step animations",
} = Astro.props;
const fullTitle = title === "firstprinciples" ? title : `${title} · firstprinciples`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Theme: the reader's saved choice, else the device setting. Runs before the CSS so there's no flash.
      (() => {
        const d = document.documentElement, mq = matchMedia("(prefers-color-scheme: dark)");
        const saved = () => { try { const v = localStorage.getItem("firstprinciples:theme"); return v === "light" || v === "dark" ? v : null; } catch { return null; } };
        const apply = () => {
          const t = saved() ?? (mq.matches ? "dark" : "light");
          d.dataset.theme = t;
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", t === "dark" ? "#0a0f1e" : "#faf5ec");
        };
        apply();
        mq.addEventListener("change", apply);
        document.addEventListener("DOMContentLoaded", apply);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="firstprinciples" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#faf5ec" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="firstprinciples: new problems and reads" href="/rss.xml" />
    <!-- Vercel Web Analytics: cookieless; starts reporting once enabled in the Vercel dashboard. -->
    <script defer src="/_vercel/insights/script.js"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500..700;1,9..144,500..700&family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,600;1,700&family=JetBrains+Mono:wght@400;600;700&display=swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">first<span>principles</span></a>
        <nav><a href="/#roadmap">Roadmap</a><a href="/concepts/">Concepts</a><a href="/topics/">Topics</a><a href="/problems/">Problems</a><a href="/practice/">Practice</a></nav>
        <Search />
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Dark theme" aria-pressed="false" title="Switch theme">
          <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg>
          <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </div>
    </header>
    <main class="wrap" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} stacknaut</span>
        <span class="footer-right">
          <a href="/cheatsheet/">Cheat sheet</a>
          <a href="/glossary/">Glossary</a>
          <a href="/feed/">RSS</a>
          <span>Made with algorithms and <span role="img" aria-label="love">❤️</span></span>
          <a class="social" href="https://www.instagram.com/stacknaut" target="_blank" rel="noopener" aria-label="stacknaut on Instagram">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
            </svg>
            <span>@stacknaut</span>
          </a>
          <a class="coffee" href="https://buymeacoffee.com/stacknaut" target="_blank" rel="noopener">
            <span aria-hidden="true">☕</span> Buy me a coffee
          </a>
        </span>
      </div>
    </footer>
    <TermPopover />
    <script>import "../lib/marks";</script>
    <script>
      const btn = document.getElementById("theme-toggle");
      const sync = () => btn?.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark"));
      sync();
      new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
      btn?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        try { localStorage.setItem("firstprinciples:theme", next); } catch {}
        document.documentElement.dataset.theme = next;
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", next === "dark" ? "#0a0f1e" : "#faf5ec");
      });
    </script>
  </body>
</html>
