---
/**
 * Time/space verdict for one approach. The badges and the "What it wastes" line (which motivates the next
 * approach) stay visible; the step-by-step working folds under "Why? Show the working", so a beginner sees the
 * answer first and opens the derivation when they want it.
 */
interface Props {
  time: string;
  space: string;
}
const { time, space } = Astro.props;
const html = await Astro.slots.render("default");
const cut = html.search(/<p><strong>What it wastes/);
const working = cut >= 0 ? html.slice(0, cut) : html;
const wastes = cut >= 0 ? html.slice(cut) : "";
---
<section class="cx" aria-label={`Complexity: time ${time}, space ${space}`}>
  <div class="cx__badges">
    <div><span>Time</span><strong>{time}</strong></div>
    <div><span>Space</span><strong>{space}</strong></div>
  </div>
  <details class="cx__work">
    <summary>Why these? Show the working</summary>
    <div class="cx__why" set:html={working} />
  </details>
  {wastes && <div class="cx__why cx__wastes" set:html={wastes} />}
</section>

<style>
  .cx {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 16px 18px;
    margin: 16px 0;
    border-left: 4px solid var(--accent);
  }
  .cx__badges { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
  .cx__badges div {
    display: flex; align-items: baseline; gap: 8px;
    background: var(--accent-soft); border-radius: 8px; padding: 4px 12px;
  }
  .cx__badges span { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .cx__badges strong { font: 700 18px var(--font-mono); color: var(--code-ink); }
  .cx__work summary {
    cursor: pointer; margin-top: 8px; font: 600 14.5px var(--font-sans); color: var(--accent); list-style: none;
  }
  .cx__work summary::-webkit-details-marker { display: none; }
  .cx__work summary::before { content: "+ "; font-family: var(--font-mono); }
  .cx__work[open] summary::before { content: "− "; }
  .cx__why :global(p) { margin: 8px 0; }
  .cx__why :global(ul) { margin: 8px 0; padding-left: 20px; }
  .cx__wastes :global(p) { margin: 10px 0 0; }
  @media print { .cx__work summary { display: none; } }
</style>
